{
  "name": "o-datamap-presentation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "content:sync": "node scripts/sync-vault-content.mjs",
    "data": "node scripts/build-vault-data.mjs",
    "demo:seed": "node scripts/seed-demo-vault.mjs --total 60 --crossEvery 6 --hubEvery 0 --sourceEvery 3 --candidateRatio 0.25",
    "map:refresh": "npm run content:sync && npm run data",
    "all": "npm run map:refresh && vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.6",
    "d3-force": "^3.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.12",
    "ml-pca": "^4.1.1",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
